# SaaSFoundry Academy — environment variables
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# Source of truth: TECH-STACK.md §5.

# --- App ---
NEXT_PUBLIC_APP_URL=https://academy.saasfoundry.xyz

# --- Analytics (optional) ---
# Set to your domain to enable privacy-friendly page-view analytics (Plausible).
# Leave blank to disable. Point NEXT_PUBLIC_PLAUSIBLE_SRC at a self-hosted
# instance if you don't use plausible.io.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_PLAUSIBLE_SRC=

# --- Supabase ---
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server-only, never exposed to the client

# --- Database (Prisma → Supabase Postgres) ---
# Project Settings → Database → Connection string
# DATABASE_URL = pooled connection (port 6543, add ?pgbouncer=true) — used at runtime
# DIRECT_URL   = direct connection (port 5432) — used by Prisma Migrate
DATABASE_URL=
DIRECT_URL=

# --- Manual payment collection (no merchant account needed) ---
# The wallet numbers buyers send money to (shown at checkout). Leave blank to
# hide that method. At least one is required for manual checkout to work.
MANUAL_BKASH_NUMBER=
MANUAL_NAGAD_NUMBER=
# Simple gate for the /admin confirm screen. Use a long random string.
# (Replaced by role-based admin auth in Slice 3.)
ADMIN_TOKEN=

# --- bKash (Tokenized Checkout / PGW) — automated gateway, for later ---
# From your bKash merchant dashboard / developer.bka.sh
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_IS_SANDBOX=true                 # flip to false in production

# --- SSLCommerz (optional; kept behind the same interface, e.g. for Rocket) ---
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_IS_SANDBOX=true           # flip to false in production

# --- Video (Bunny Stream, added later) ---
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=

# --- Email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM="SaaSFoundry Academy <no-reply@saasfoundry.xyz>"
